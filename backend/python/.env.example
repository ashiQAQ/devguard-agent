# DevGuard Agent 配置模板
# 复制为 .env 并修改

# ============================================
# 基础配置
# ============================================
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=postgresql://devguard:devguard@localhost:5432/devguard
REDIS_URL=redis://localhost:6379/0

# ============================================
# C++ 引擎配置
# ============================================
CPP_ENGINE_HOST=localhost
CPP_ENGINE_PORT=9000

# ============================================
# GitHub/GitLab 集成
# ============================================
GITHUB_TOKEN=
GITLAB_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4

# ============================================
# AI 配置（统一字段，切换时只需修改 PROVIDER）
# ============================================
# 提供者类型: openai / azure / local / mock
AI_PROVIDER=mock

# API Key（所有提供者共用）
AI_API_KEY=

# API 端点
# - OpenAI: https://api.openai.com/v1
# - Azure:  https://your-resource.openai.azure.com/
# - Local:  http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# 模型名称
# - OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# - Azure:  deployment name
# - Local:  llama3, qwen2, etc.
AI_MODEL=gpt-4o

# Embedding 模型（可选）
AI_EMBEDDING_MODEL=text-embedding-3-small

# Azure 专用：API 版本
AI_API_VERSION=2024-02-01

# 模型参数
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
AI_TIMEOUT=60

# 功能配置
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600
AI_MAX_CONTENT_LENGTH=8000
AI_BATCH_SIZE=5

# ============================================
# 配置示例（切换时注释/取消注释）
# ============================================

# --- OpenAI 配置 ---
# AI_PROVIDER=openai
# AI_API_KEY=sk-xxx
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o

# --- Azure OpenAI 配置 ---
# AI_PROVIDER=azure
# AI_API_KEY=xxx
# AI_BASE_URL=https://your-resource.openai.azure.com/
# AI_MODEL=gpt-4o-deployment
# AI_API_VERSION=2024-02-01

# --- 本地模型配置 (Ollama) ---
# AI_PROVIDER=local
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3

# --- Mock 配置（测试用）---
# AI_PROVIDER=mock

# ============================================
# 仿真配置
# ============================================
SIMULATION_ADCU_BINARY=/usr/local/bin/devguard-adcu
SIMULATION_SCENARIO_DIR=/data/scenarios
SIMULATION_TIMEOUT=300

# ============================================
# 性能配置
# ============================================
MAX_WORKERS=4
REQUEST_TIMEOUT=60
