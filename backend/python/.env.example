# DevGuard Agent 环境配置示例
# 复制此文件为 .env 并修改配置

# ============================================
# 数据库配置（MySQL 生产环境）
# ============================================
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/devguard

# ============================================
# 数据库配置（SQLite 开发环境）
# ============================================
# DATABASE_URL=sqlite:////Users/fengxinfeng/.qclaw/workspace/aa/devguard-agent/data/devguard.db

# ============================================
# AI 配置
# ============================================
# 可选值: openai, azure, local, mock
AI_PROVIDER=mock

# OpenAI
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
DEBUG=false